RED = "\033[91m"
RESET = "\033[0m"


def print_logo():
    """Очищает консоль и выводит логотип."""
    sys.stdout.write("\033[H\033[J")
    sys.stdout.write(RED + LOGO + RESET + "\n")
    sys.stdout.flush()


def open_child_window():
    """Запускает дочерний процесс fsociety в новом окне консоли."""
    script_path = os.path.abspath(sys.argv[0])

    if sys.platform == "win32":
        subprocess.Popen(
            [sys.executable, script_path, "--child"],
            creationflags=subprocess.CREATE_NEW_CONSOLE,
        )
    elif sys.platform == "darwin":
        subprocess.Popen(
            [
                "osascript",
                "-e",
                f'tell application "Terminal" to do script "{sys.executable} \'{script_path}\' --child"',
            ]
        )
    else:
        for term in ["x-terminal-emulator", "gnome-terminal", "konsole", "xterm"]:
            try:
                subprocess.Popen([term, "-e", sys.executable, script_path, "--child"])
                break
            except FileNotFoundError:
                continue


def open_antivirus(exe_path):
    """Запускает файл антивируса."""
    try:
        if sys.platform == "win32":
            subprocess.Popen([exe_path], creationflags=subprocess.CREATE_NEW_CONSOLE)
        else:
            subprocess.Popen([exe_path])
    except Exception as e:
        print(f"\n[!] Ошибка запуска '{exe_path}': {e}")


def main():
    if "--child" in sys.argv:
        print_logo()
        input("\nНажмите Enter для закрытия окна...")
        return

    base_dir = os.path.dirname(os.path.abspath(sys.argv[0]))
    antivirus_path = os.path.join(base_dir, ANTIVIRUS_EXE)

    if not os.path.exists(antivirus_path):
        print(f"[!] Ошибка: Файл '{ANTIVIRUS_EXE}' не найден в папке:")
        print(f"    {base_dir}")
        input("Нажмите Enter для выхода...")
        return

    print("Запуск браузера и автовоспроизведение видео...")
    driver = None
    try:
        options = webdriver.ChromeOptions()
        options.add_argument("--autoplay-policy=no-user-gesture-required")
        driver = webdriver.Chrome(
            service=ChromeService(ChromeDriverManager().install()),
            options=options,
        )
        driver.get(YOUTUBE_URL)
    except Exception as e:
        print(f"[!] Не удалось запустить Chrome через Selenium: {e}")
        import webbrowser

        webbrowser.open(YOUTUBE_URL)

    print(
        f"Запущен таймер на {VIDEO_WAIT_TIME} сек. Браузер закроется на {CLOSE_BROWSER_TIME}-й секунде."
    )

    for elapsed in range(1, VIDEO_WAIT_TIME + 1):
        remaining = VIDEO_WAIT_TIME - elapsed
        sys.stdout.write(f"\rПрошло: {elapsed} сек. | Осталось: {remaining} сек. ")
        sys.stdout.flush()

        if elapsed == CLOSE_BROWSER_TIME and driver:
            try:
                driver.quit()
                driver = None
                sys.stdout.write(" [Браузер закрыт]")
                sys.stdout.flush()
            except Exception:
                pass

        time.sleep(1)

    print("\n\nОткрытие окон fsociety и антивируса...")

    print_logo()

    EXTRA_PAIRS_COUNT = 4
    for _ in range(EXTRA_PAIRS_COUNT):
        open_child_window()
        open_antivirus(antivirus_path)
        time.sleep(0.1)

    print(f"\nЗапущено {EXTRA_PAIRS_COUNT} дополнительных пар окон.")
    input("\nНажмите Enter, чтобы завершить главный процесс...")


if __name__ == "__main__":
    main()
